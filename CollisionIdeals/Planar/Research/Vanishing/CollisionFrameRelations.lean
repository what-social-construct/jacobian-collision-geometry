import CollisionIdeals.Planar.Research.KellerFrameExtension
import CollisionIdeals.General.Galois.ConjugatePolynomialPresentation
import CollisionIdeals.General.Normalization.FilteredPolynomialDerivation

/-!
# The actual Keller frame respects the conjugate-coordinate relations

In the existing ground-polynomial presentation of the all-conjugate
algebra, the lifted frame differentiates a coordinate on each sheet by
the renamed source inverse-Jacobian formula. It kills each same-image
relation `F_j(Z_g) - F_j(Z_1)` exactly. Their generated ideal is stable
and is contained in the kernel of the existing coordinate evaluation.

Evaluation intertwines this polynomial lift with the existing frame on
the marked normal closure, so its full kernel is also stable. No new
conjugate algebra or quotient is defined. Stability alone supplies no
normal-form reduction, bounded degree, or uniform finite module stage.

Diagonal evaluation onto the marked polynomial source kills the same-image
ideal. Consequently a polynomial inverse certificate modulo this ideal can
invert only an element already invertible in that source. This diagnoses
inverse certificates, not every possible finite derivative reduction.
-/

set_option autoImplicit false
set_option maxHeartbeats 800000

namespace CollisionIdeals

noncomputable section

open MvPolynomial

variable {F : PlanarPolynomialMap} {N : Type} [Field N]
variable [Algebra (PolynomialMapBaseFunctionField F) N]

@[reducible] local instance collisionFrameRelationsBaseAlgebra :
    Algebra (PolynomialImageAlgebra F) N :=
  polynomialNormalExtensionBaseAlgebra (F := F) (N := N)

/-- The actual inverse-Jacobian frame on the ground polynomial
presentation: each generator is differentiated on its own source sheet. -/
def planarKellerConjugateCoordinateFrame
    (D : PolynomialNormalClosureData F N) (c : ℂ) (i : Fin 2) :
    Derivation ℂ (MvPolynomial (D.galoisGroup × Fin 2) ℂ)
      (MvPolynomial (D.galoisGroup × Fin 2) ℂ) := by
  letI : Finite D.galoisGroup := D.finiteGaloisGroup
  letI : Fintype D.galoisGroup := Fintype.ofFinite _
  exact polynomialGeneratorDerivation fun gj =>
    rename (fun j : Fin 2 => (gj.1, j))
      ((Fin.cases (planarKellerFirstFrame F c)
        (fun _ => planarKellerSecondFrame F c) i :
          Derivation ℂ PlanePolynomial PlanePolynomial) (X gj.2))

@[simp]
theorem planarKellerConjugateCoordinateFrame_X
    (D : PolynomialNormalClosureData F N) (c : ℂ) (i : Fin 2)
    (gj : D.galoisGroup × Fin 2) :
    planarKellerConjugateCoordinateFrame D c i (X gj) =
      rename (fun j : Fin 2 => (gj.1, j))
        ((Fin.cases (planarKellerFirstFrame F c)
          (fun _ => planarKellerSecondFrame F c) i :
            Derivation ℂ PlanePolynomial PlanePolynomial) (X gj.2)) := by
  simp only [planarKellerConjugateCoordinateFrame, polynomialGeneratorDerivation_X]

/-- The actual lift agrees with the polynomial source frame on every
renamed sheet, before taking the coordinate-evaluation quotient. -/
theorem planarKellerConjugateCoordinateFrame_rename
    (D : PolynomialNormalClosureData F N) (c : ℂ) (i : Fin 2)
    (g : D.galoisGroup) (P : PlanePolynomial) :
    planarKellerConjugateCoordinateFrame D c i (rename (fun j : Fin 2 => (g, j)) P) =
      rename (fun j : Fin 2 => (g, j))
        ((Fin.cases (planarKellerFirstFrame F c)
          (fun _ => planarKellerSecondFrame F c) i :
            Derivation ℂ PlanePolynomial PlanePolynomial) P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add P Q hP hQ => simp only [map_add, hP, hQ]
  | mul_X P j hP =>
      simp only [map_mul, rename_X, Derivation.leibniz, smul_eq_mul,
        planarKellerConjugateCoordinateFrame_X, hP, map_add]

/-- The same-image relation between a conjugate sheet and the marked
sheet in the existing ground-polynomial coordinate presentation. -/
def planarConjugateSameImageRelation
    (D : PolynomialNormalClosureData F N) (g : D.galoisGroup) (j : Fin 2) :
    MvPolynomial (D.galoisGroup × Fin 2) ℂ :=
  rename (fun l : Fin 2 => (g, l)) (F j) -
    rename (fun l : Fin 2 => (1, l)) (F j)

/-- The ideal generated by the actual same-image coordinate relations.
It is not asserted to be the entire evaluation kernel. -/
def planarConjugateSameImageIdeal (D : PolynomialNormalClosureData F N) :
    Ideal (MvPolynomial (D.galoisGroup × Fin 2) ℂ) :=
  Ideal.span (Set.range fun gj : D.galoisGroup × Fin 2 =>
    planarConjugateSameImageRelation D gj.1 gj.2)

/-- Collapsing every sheet onto the marked polynomial source kills the
same-image ideal; no assertion about the actual marked kernel is used. -/
theorem planarConjugateSameImageIdeal_le_diagonalEvalKer
    (D : PolynomialNormalClosureData F N) :
    planarConjugateSameImageIdeal D ≤ RingHom.ker
      (aeval (fun gj : D.galoisGroup × Fin 2 =>
        (X gj.2 : PlanePolynomial))).toRingHom := by
  rw [planarConjugateSameImageIdeal, Ideal.span_le]
  rintro P ⟨⟨g, j⟩, rfl⟩
  change aeval (fun gj : D.galoisGroup × Fin 2 =>
    (X gj.2 : PlanePolynomial)) (planarConjugateSameImageRelation D g j) = 0
  rw [planarConjugateSameImageRelation, map_sub, aeval_rename, aeval_rename]
  change aeval X (F j) - aeval X (F j) = 0
  exact sub_self _

/-- An inverse certified using only same-image relations already inverts
the original source polynomial. Nonunit boundary equations therefore
cannot acquire such an inverse certificate from this ideal alone. -/
theorem isUnit_of_planarConjugateSameImage_inverse_relation
    (D : PolynomialNormalClosureData F N) (s : PlanePolynomial)
    (P : MvPolynomial (D.galoisGroup × Fin 2) ℂ)
    (h : rename (fun j : Fin 2 => (1, j)) s * P - 1 ∈
      planarConjugateSameImageIdeal D) : IsUnit s := by
  have hDiag := planarConjugateSameImageIdeal_le_diagonalEvalKer D h
  change aeval (fun gj : D.galoisGroup × Fin 2 =>
    (X gj.2 : PlanePolynomial))
      (rename (fun j : Fin 2 => (1, j)) s * P - 1) = 0 at hDiag
  rw [map_sub, map_mul, map_one, aeval_rename] at hDiag
  change aeval X s * aeval (fun gj : D.galoisGroup × Fin 2 =>
    (X gj.2 : PlanePolynomial)) P - 1 = 0 at hDiag
  rw [aeval_X_left_apply] at hDiag
  exact IsUnit.of_mul_eq_one _ (sub_eq_zero.mp hDiag)

/-- The source duality identities cancel exactly between the two sheets. -/
theorem planarKellerConjugateCoordinateFrame_sameImageRelation
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = C c) (i : Fin 2)
    (g : D.galoisGroup) (j : Fin 2) :
    planarKellerConjugateCoordinateFrame D c i
      (planarConjugateSameImageRelation D g j) = 0 := by
  rw [planarConjugateSameImageRelation, map_sub,
    planarKellerConjugateCoordinateFrame_rename,
    planarKellerConjugateCoordinateFrame_rename]
  cases i using Fin.cases <;> fin_cases j <;>
    simp [planarKellerFirstFrame_apply_first F c hc hJ,
      planarKellerFirstFrame_apply_second F c,
      planarKellerSecondFrame_apply_first F c,
      planarKellerSecondFrame_apply_second F c hc hJ]

/-- Stability of the explicitly generated same-image ideal follows from
the exact generator identities and the polynomial Leibniz rule. -/
theorem planarKellerConjugateCoordinateFrame_mem_sameImageIdeal
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = C c) (i : Fin 2)
    {P : MvPolynomial (D.galoisGroup × Fin 2) ℂ}
    (hP : P ∈ planarConjugateSameImageIdeal D) :
    planarKellerConjugateCoordinateFrame D c i P ∈ planarConjugateSameImageIdeal D := by
  change P ∈ Submodule.span _ _ at hP
  induction hP using Submodule.span_induction with
  | mem P hP =>
      obtain ⟨⟨g, j⟩, rfl⟩ := hP
      rw [planarKellerConjugateCoordinateFrame_sameImageRelation D c hc hJ]
      exact (planarConjugateSameImageIdeal D).zero_mem
  | zero => simpa only [map_zero] using (planarConjugateSameImageIdeal D).zero_mem
  | add P Q _ _ hP hQ =>
      rw [map_add]
      exact (planarConjugateSameImageIdeal D).add_mem hP hQ
  | smul a P hP ih =>
      rw [smul_eq_mul, Derivation.leibniz, smul_eq_mul, smul_eq_mul]
      exact (planarConjugateSameImageIdeal D).add_mem
        ((planarConjugateSameImageIdeal D).mul_mem_left a ih)
        ((planarConjugateSameImageIdeal D).mul_mem_right _ hP)

/-- Same-image generators vanish under the already existing evaluation. -/
theorem planarConjugateSameImageRelation_eval
    (D : PolynomialNormalClosureData F N) (g : D.galoisGroup) (j : Fin 2) :
    letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
    polynomialConjugateCoordinateEval D (planarConjugateSameImageRelation D g j) = 0 := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  rw [planarConjugateSameImageRelation, map_sub,
    polynomialConjugateCoordinateEval_rename, polynomialConjugateCoordinateEval_rename]
  exact sub_eq_zero.mpr (polynomialConjugateSourceMapOverImage_apply_F_eq D g 1 j)

/-- The explicitly generated relation ideal lies in the actual kernel.
Equality with that kernel is neither needed nor asserted. -/
theorem planarConjugateSameImageIdeal_le_evalKer
    (D : PolynomialNormalClosureData F N) :
    letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
    planarConjugateSameImageIdeal D ≤
      RingHom.ker (polynomialConjugateCoordinateEval D).toRingHom := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  apply Ideal.span_le.mpr
  rintro P ⟨⟨g, j⟩, rfl⟩
  exact planarConjugateSameImageRelation_eval D g j

/-- Coordinate evaluation intertwines the actual lifted polynomial frame
with the existing marked-normal-closure frame. -/
theorem planarKellerConjugateCoordinateFrame_eval
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = C c) (i : Fin 2)
    (P : MvPolynomial (D.galoisGroup × Fin 2) ℂ) :
    letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
    polynomialConjugateCoordinateEval D (planarKellerConjugateCoordinateFrame D c i P) =
      (Fin.cases (planarKellerFirstFrameNormal D c)
        (fun _ => planarKellerSecondFrameNormal D c) i : Derivation ℂ N N)
          (polynomialConjugateCoordinateEval D P) := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  letI : Finite D.galoisGroup := D.finiteGaloisGroup
  letI : Fintype D.galoisGroup := Fintype.ofFinite _
  let x : D.galoisGroup × Fin 2 → N :=
    fun gj => polynomialConjugateSourceMap D gj.1 (X gj.2)
  let delta : Derivation ℂ N N := Fin.cases (planarKellerFirstFrameNormal D c)
    (fun _ => planarKellerSecondFrameNormal D c) i
  let v : D.galoisGroup × Fin 2 → MvPolynomial (D.galoisGroup × Fin 2) ℂ :=
    fun gj => rename (fun j : Fin 2 => (gj.1, j))
      ((Fin.cases (planarKellerFirstFrame F c)
        (fun _ => planarKellerSecondFrame F c) i :
          Derivation ℂ PlanePolynomial PlanePolynomial) (X gj.2))
  have hGenerator : ∀ gj, delta (x gj) = aeval x (v gj) := by
    intro gj
    fin_cases i
    · change planarKellerFirstFrameNormal D c (polynomialConjugateSourceMap D gj.1 (X gj.2)) =
        polynomialConjugateCoordinateEval D
          (rename (fun j : Fin 2 => (gj.1, j)) (planarKellerFirstFrame F c (X gj.2)))
      rw [polynomialConjugateCoordinateEval_rename]
      exact planarKellerFirstFrameNormal_conjugate_polynomial D c hc hJ gj.1 (X gj.2)
    · change planarKellerSecondFrameNormal D c (polynomialConjugateSourceMap D gj.1 (X gj.2)) =
        polynomialConjugateCoordinateEval D
          (rename (fun j : Fin 2 => (gj.1, j)) (planarKellerSecondFrame F c (X gj.2)))
      rw [polynomialConjugateCoordinateEval_rename]
      exact planarKellerSecondFrameNormal_conjugate_polynomial D c hc hJ gj.1 (X gj.2)
  exact (derivation_aeval_eq_polynomialGeneratorDerivation x delta v hGenerator P).symm

/-- The full actual evaluation kernel is stable under the actual
polynomial lift, not only under a derivation supplied as extra data. -/
theorem planarKellerConjugateCoordinateFrame_mem_evalKer
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = C c) (i : Fin 2)
    {P : MvPolynomial (D.galoisGroup × Fin 2) ℂ}
    (hP : letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
      P ∈ RingHom.ker (polynomialConjugateCoordinateEval D).toRingHom) :
    letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
    planarKellerConjugateCoordinateFrame D c i P ∈
      RingHom.ker (polynomialConjugateCoordinateEval D).toRingHom := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  change polynomialConjugateCoordinateEval D P = 0 at hP
  change polynomialConjugateCoordinateEval D (planarKellerConjugateCoordinateFrame D c i P) = 0
  rw [planarKellerConjugateCoordinateFrame_eval D c hc hJ, hP, map_zero]

end

end CollisionIdeals

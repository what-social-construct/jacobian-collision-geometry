import CollisionIdeals.Planar.Research.Vanishing.BaseFrame
import CollisionIdeals.General.Keller.ConjugateInvariantConormal
import CollisionIdeals.General.Normalization.DerivationSubalgebra

/-!
# The Keller frame on the actual fixed algebra

The existing normal-closure Keller frames preserve the algebra generated by
the conjugate source coordinates and the embedded target function field.
They therefore preserve their intersection, the existing fixed algebra.

The restricted additive operators use its original base action and satisfy
the target-coordinate Leibniz rules. No normalization boundary ring,
finite module stage, or uniform annihilator is asserted to be preserved.
-/

set_option autoImplicit false
set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 80000

namespace CollisionIdeals

noncomputable section

variable {F : PlanarPolynomialMap} {N : Type} [Field N]
variable [Algebra (PolynomialMapBaseFunctionField F) N]

@[reducible] local instance invariantFrameBaseAlgebra :
    Algebra (PolynomialImageAlgebra F) N :=
  polynomialNormalExtensionBaseAlgebra (F := F) (N := N)

@[reducible] local instance invariantFrameBaseFieldAlgebra :
    Algebra (PolynomialImageAlgebra F) (PolynomialMapBaseFunctionField F) :=
  OreLocalization.instAlgebra

local instance invariantFrameBaseFieldSMul :
    SMul (PolynomialImageAlgebra F) (PolynomialMapBaseFunctionField F) := Algebra.toSMul

local instance invariantFrameBaseFieldTower :
    IsScalarTower (PolynomialImageAlgebra F) (PolynomialMapBaseFunctionField F) N :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl

@[reducible] local instance invariantFrameImageAlgebra
    (D : PolynomialNormalClosureData F N) :
    Algebra (PolynomialImageAlgebra F) (polynomialConjugateAlgebra D) :=
  Subalgebra.algebra (polynomialConjugateAlgebra D)

@[reducible] local instance invariantFrameInvariantAlgebra
    (D : PolynomialNormalClosureData F N) :
    Algebra (PolynomialImageAlgebra F) (polynomialConjugateInvariantAlgebra D) :=
  Subalgebra.algebra (polynomialConjugateInvariantAlgebra D)

local instance invariantFrameImageSMul (D : PolynomialNormalClosureData F N) :
    SMul (PolynomialImageAlgebra F) (polynomialConjugateAlgebra D) := Algebra.toSMul

local instance invariantFrameInvariantSMul (D : PolynomialNormalClosureData F N) :
    SMul (PolynomialImageAlgebra F) (polynomialConjugateInvariantAlgebra D) := Algebra.toSMul

private def normalFrame (D : PolynomialNormalClosureData F N) (c : ℂ) (i : Fin 2) :
    letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
    Derivation ℂ N N :=
  Fin.cases (planarKellerFirstFrameNormal D c)
    (fun _ => planarKellerSecondFrameNormal D c) i

private def targetPartial (D : PolynomialNormalClosureData F N) (i : Fin 2) :
    Derivation ℂ (PolynomialImageAlgebra F) (PolynomialImageAlgebra F) := by
  letI := D.finiteIntermediate
  exact polynomialImageCoordinatePartial F i

private theorem normalFrame_algebraMap
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = MvPolynomial.C c) (i : Fin 2)
    (b : PolynomialImageAlgebra F) :
    normalFrame D c i (algebraMap (PolynomialImageAlgebra F) N b) =
      algebraMap (PolynomialImageAlgebra F) N (targetPartial D i b) := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  letI := D.finiteIntermediate
  obtain ⟨p, hp⟩ := b.property
  have hb : (coordinateAlgHom F).rangeRestrict p = b := Subtype.ext hp
  rw [← hb]
  change normalFrame D c i
      (algebraMap (PolynomialImageAlgebra F) N ((coordinateAlgHom F).rangeRestrict p)) =
    algebraMap (PolynomialImageAlgebra F) N
      (polynomialImageCoordinatePartial F i ((coordinateAlgHom F).rangeRestrict p))
  rw [polynomialImageCoordinatePartial_rangeRestrict]
  have hbase (q : PlanePolynomial) :
      algebraMap (PolynomialImageAlgebra F) N ((coordinateAlgHom F).rangeRestrict q) =
        polynomialConjugateSourceMap D 1 (coordinateAlgHom F q) := by
    exact ((polynomialConjugateSourceMapOverImage D 1).commutes
      ((coordinateAlgHom F).rangeRestrict q)).symm
  rw [hbase, hbase]
  fin_cases i
  · exact planarKellerFirstFrameNormal_conjugate_coordinateAlgHom D c hc hJ 1 p
  · exact planarKellerSecondFrameNormal_conjugate_coordinateAlgHom D c hc hJ 1 p

private theorem normalFrame_conjugate_polynomial_mem
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = MvPolynomial.C c) (i : Fin 2)
    (g : D.galoisGroup) (p : PlanePolynomial) :
    normalFrame D c i (polynomialConjugateSourceMapOverImage D g p) ∈
      polynomialConjugateAlgebra D := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  fin_cases i
  · change planarKellerFirstFrameNormal D c (polynomialConjugateSourceMap D g p) ∈
      polynomialConjugateAlgebra D
    rw [planarKellerFirstFrameNormal_conjugate_polynomial D c hc hJ]
    exact polynomialConjugateAlgebra_polynomial_mem D g (planarKellerFirstFrame F c p)
  · change planarKellerSecondFrameNormal D c (polynomialConjugateSourceMap D g p) ∈
      polynomialConjugateAlgebra D
    rw [planarKellerSecondFrameNormal_conjugate_polynomial D c hc hJ]
    exact polynomialConjugateAlgebra_polynomial_mem D g (planarKellerSecondFrame F c p)

private theorem normalFrame_mem_conjugateAlgebra
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = MvPolynomial.C c) (i : Fin 2)
    {z : N} (hz : z ∈ polynomialConjugateAlgebra D) :
    normalFrame D c i z ∈ polynomialConjugateAlgebra D := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  apply derivation_mem_adjoin_of_generators (normalFrame D c i) _ ?_ ?_ hz
  · intro b
    rw [normalFrame_algebraMap D c hc hJ]
    exact (polynomialConjugateAlgebra D).algebraMap_mem _
  · rintro z ⟨⟨g, j⟩, rfl⟩
    exact normalFrame_conjugate_polynomial_mem D c hc hJ i g (MvPolynomial.X j)

private theorem normalFrame_mem_baseField
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = MvPolynomial.C c) (i : Fin 2)
    {z : N} (hz : z ∈ Set.range (algebraMap (PolynomialMapBaseFunctionField F) N)) :
    normalFrame D c i z ∈ Set.range (algebraMap (PolynomialMapBaseFunctionField F) N) := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  apply derivation_mem_range_fractionRing_of_base
    (B := PolynomialImageAlgebra F) (normalFrame D c i) ?_ hz
  intro b
  rw [normalFrame_algebraMap D c hc hJ]
  exact ⟨algebraMap (PolynomialImageAlgebra F) (PolynomialMapBaseFunctionField F)
    (targetPartial D i b), rfl⟩

private theorem normalFrame_mem_invariants
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = MvPolynomial.C c) (i : Fin 2)
    (z : polynomialConjugateInvariantAlgebra D) :
    (⟨normalFrame D c i (z.val : N),
      normalFrame_mem_conjugateAlgebra D c hc hJ i z.val.property⟩ :
      polynomialConjugateAlgebra D) ∈ polynomialConjugateInvariantAlgebra D := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  letI : FiniteDimensional (PolynomialMapBaseFunctionField F) N := D.finiteNormal
  letI : Algebra.IsSeparable (PolynomialMapBaseFunctionField F) N := inferInstance
  apply (polynomialConjugateInvariantAlgebra_mem_iff_baseField D _).mpr
  exact normalFrame_mem_baseField D c hc hJ i
    ((polynomialConjugateInvariantAlgebra_mem_iff_baseField D z.val).mp z.property)

/-- Restrict the existing normal-closure Keller frame to the actual fixed
algebra. Its original base action is retained. -/
def planarKellerInvariantFrame
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = MvPolynomial.C c) (i : Fin 2) :
    polynomialConjugateInvariantAlgebra D →+ polynomialConjugateInvariantAlgebra D := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  exact
    { toFun := fun z => ⟨⟨normalFrame D c i (z.val : N),
        normalFrame_mem_conjugateAlgebra D c hc hJ i z.val.property⟩,
        normalFrame_mem_invariants D c hc hJ i z⟩
      map_zero' := by
        apply Subtype.ext
        apply Subtype.ext
        exact map_zero (normalFrame D c i)
      map_add' := fun x y => by
        apply Subtype.ext
        apply Subtype.ext
        exact map_add (normalFrame D c i) (x.val : N) (y.val : N) }

/-- The actual restriction agrees in the normal closure with the existing
first or second Keller frame, according to the target-coordinate index. -/
@[simp]
theorem planarKellerInvariantFrame_coe
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = MvPolynomial.C c) (i : Fin 2)
    (z : polynomialConjugateInvariantAlgebra D) :
    letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
    ((planarKellerInvariantFrame D c hc hJ i z).val : N) =
      (Fin.cases (planarKellerFirstFrameNormal D c)
        (fun _ => planarKellerSecondFrameNormal D c) i : Derivation ℂ N N) (z.val : N) := rfl

/-- The restricted frame differentiates base functions by the existing
transported target-coordinate partial. -/
theorem planarKellerInvariantFrame_algebraMap
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = MvPolynomial.C c) (i : Fin 2)
    (b : PolynomialImageAlgebra F) :
    letI := D.finiteIntermediate
    planarKellerInvariantFrame D c hc hJ i
        (algebraMap (PolynomialImageAlgebra F) (polynomialConjugateInvariantAlgebra D) b) =
      algebraMap (PolynomialImageAlgebra F) (polynomialConjugateInvariantAlgebra D)
        (polynomialImageCoordinatePartial F i b) := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  letI := D.finiteIntermediate
  apply Subtype.ext
  apply Subtype.ext
  exact normalFrame_algebraMap D c hc hJ i b

/-- The target-coordinate Leibniz identity on the same actual fixed algebra.
It supplies no finite-stage preservation statement. -/
theorem planarKellerInvariantFrame_leibniz
    (D : PolynomialNormalClosureData F N) (c : ℂ) (hc : c ≠ 0)
    (hJ : planarJacobianDet F = MvPolynomial.C c) (i : Fin 2)
    (b : PolynomialImageAlgebra F) (z : polynomialConjugateInvariantAlgebra D) :
    letI := D.finiteIntermediate
    planarKellerInvariantFrame D c hc hJ i (b • z) =
      polynomialImageCoordinatePartial F i b • z +
        b • planarKellerInvariantFrame D c hc hJ i z := by
  letI : Algebra ℂ N := polynomialNormalExtensionGroundAlgebra (F := F) (N := N)
  letI := D.finiteIntermediate
  apply Subtype.ext
  apply Subtype.ext
  change normalFrame D c i (algebraMap (PolynomialImageAlgebra F) N b * (z.val : N)) =
    algebraMap (PolynomialImageAlgebra F) N (polynomialImageCoordinatePartial F i b) *
        (z.val : N) +
      algebraMap (PolynomialImageAlgebra F) N b * normalFrame D c i (z.val : N)
  rw [(normalFrame D c i).leibniz, normalFrame_algebraMap D c hc hJ]
  simp only [smul_eq_mul, targetPartial]
  ring

end

end CollisionIdeals

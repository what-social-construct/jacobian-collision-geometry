import CollisionIdeals.Planar.ExplicitSecant
import CollisionIdeals.General.FiberProduct.UniversalProperty

/-!
# Evaluating the canonical planar collision projector

The existing ordered divided-difference determinant and projector are
evaluated on actual collision map pairs. The off-diagonal projector is zero
on a diagonal pair and one on a distinct pair with values in a domain.
Consequently the coordinate differences of a distinct Keller collision
pair generate the unit ideal in its target ring, not merely in a fraction
field. No generic-degree or Galois-rigidity hypothesis is used.
-/

set_option autoImplicit false

namespace CollisionIdeals.Planar.Research

open MvPolynomial

noncomputable section

universe u

variable {T : Type u} [CommRing T] [Algebra ℂ T]

/-- Evaluating a diagonal-ideal element gives an element of the ideal
generated by the two evaluated coordinate differences. -/
theorem collisionPairMap_diagonalIdeal_mem_span_coordinateDifferences
    (F : PlanarPolynomialMap) (s : CollisionMapPair F T)
    (z : PairRing ℂ (Fin 2))
    (hz : z ∈ diagonalIdeal (R := ℂ) (ι := Fin 2)) :
    collisionPairMap s z ∈
      Ideal.span (Set.range fun i : Fin 2 => s.left (X i) - s.right (X i)) := by
  let J : Ideal T :=
    Ideal.span (Set.range fun i : Fin 2 => s.left (X i) - s.right (X i))
  have hdiag : diagonalIdeal (R := ℂ) (ι := Fin 2) ≤
      Ideal.comap (collisionPairMap s).toRingHom J := by
    rw [diagonalIdeal, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    change collisionPairMap s (diagonalGenerator (R := ℂ) i) ∈ J
    simpa [collisionPairMap, diagonalGenerator] using
      (Ideal.subset_span (Set.mem_range_self i) :
        s.left (X i) - s.right (X i) ∈ J)
  exact hdiag hz

/-- The canonical determinant annihilates every evaluated collision
coordinate difference. -/
theorem collisionPairMap_explicitDeterminant_mul_coordinateDifference_eq_zero
    (F : PlanarPolynomialMap) (s : CollisionMapPair F T) (i : Fin 2) :
    collisionPairMap s (ExplicitSecant.determinant F) *
      (s.left (X i) - s.right (X i)) = 0 := by
  have hz := ExplicitSecant.determinant_mul_diagonalIdeal_mem_collisionIdeal
    F (diagonalGenerator (R := ℂ) i) (diagonalGenerator_mem (R := ℂ) i)
  have h := collisionIdeal_le_collisionPairMap_ker s hz
  change collisionPairMap s
    (ExplicitSecant.determinant F * diagonalGenerator (R := ℂ) i) = 0 at h
  simpa [map_mul, collisionPairMap, diagonalGenerator] using h

/-- A distinct collision pair in a domain evaluates the canonical
determinant to zero. -/
theorem collisionPairMap_explicitDeterminant_eq_zero_of_left_ne_right
    [IsDomain T] (F : PlanarPolynomialMap) (s : CollisionMapPair F T)
    (hne : s.left ≠ s.right) :
    collisionPairMap s (ExplicitSecant.determinant F) = 0 := by
  obtain ⟨i, hi⟩ := exists_coordinate_moved_of_collision_maps_ne s hne
  exact (mul_eq_zero.mp
    (collisionPairMap_explicitDeterminant_mul_coordinateDifference_eq_zero F s i)).resolve_right
      (sub_ne_zero.mpr hi)

/-- A diagonal collision pair evaluates the canonical determinant to
the supplied Jacobian constant. -/
theorem collisionPairMap_explicitDeterminant_eq_constant_of_left_eq_right
    (F : PlanarPolynomialMap) (c : ℂ)
    (hJacobian : planarJacobianDet F = C c)
    (s : CollisionMapPair F T) (hsame : s.left = s.right) :
    collisionPairMap s (ExplicitSecant.determinant F) = algebraMap ℂ T c := by
  have hmap : collisionPairMap s = s.left.comp diagonalEval := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i with
    | inl i => simp [collisionPairMap, diagonalEval]
    | inr i => simp [collisionPairMap, diagonalEval, hsame]
  rw [hmap]
  change s.left (diagonalEval (ExplicitSecant.determinant F)) = _
  rw [ExplicitSecant.diagonalEval_determinant_eq_planarJacobianDet, hJacobian]
  simp

/-- Evaluation preserves the canonical projector's normalized
divided-difference formula. -/
theorem collisionLift_explicitProjector_formula
    (F : PlanarPolynomialMap) (c : ℂ) (hc : c ≠ 0)
    (s : CollisionMapPair F T) :
    collisionLift s (ExplicitSecant.collisionProjector F c hc) =
      1 - algebraMap ℂ T c⁻¹ * collisionPairMap s (ExplicitSecant.determinant F) := by
  simp [ExplicitSecant.collisionProjector, offDiagonalIdempotent,
    ExplicitSecant.collisionConstantUnit, collisionLift]
  congr 1
  change collisionPairMap s (C c⁻¹) = algebraMap ℂ T c⁻¹
  simp

/-- The off-diagonal canonical projector evaluates to zero on a
diagonal collision pair. -/
theorem collisionLift_explicitProjector_eq_zero_of_left_eq_right
    (F : PlanarPolynomialMap) (c : ℂ) (hc : c ≠ 0)
    (hJacobian : planarJacobianDet F = C c)
    (s : CollisionMapPair F T) (hsame : s.left = s.right) :
    collisionLift s (ExplicitSecant.collisionProjector F c hc) = 0 := by
  rw [collisionLift_explicitProjector_formula,
    collisionPairMap_explicitDeterminant_eq_constant_of_left_eq_right F c hJacobian s hsame,
    ← map_mul, inv_mul_cancel₀ hc, map_one, sub_self]

/-- The off-diagonal canonical projector evaluates to one on a
distinct collision pair in a domain. -/
theorem collisionLift_explicitProjector_eq_one_of_left_ne_right
    [IsDomain T] (F : PlanarPolynomialMap) (c : ℂ) (hc : c ≠ 0)
    (s : CollisionMapPair F T) (hne : s.left ≠ s.right) :
    collisionLift s (ExplicitSecant.collisionProjector F c hc) = 1 := by
  rw [collisionLift_explicitProjector_formula,
    collisionPairMap_explicitDeterminant_eq_zero_of_left_ne_right F s hne,
    mul_zero, sub_zero]

/-- The evaluated canonical off-diagonal projector belongs to the
ideal generated by the evaluated coordinate differences. -/
theorem collisionLift_explicitProjector_mem_span_coordinateDifferences
    (F : PlanarPolynomialMap) (c : ℂ) (hc : c ≠ 0)
    (hJacobian : planarJacobianDet F = C c)
    (s : CollisionMapPair F T) :
    collisionLift s (ExplicitSecant.collisionProjector F c hc) ∈
      Ideal.span (Set.range fun i : Fin 2 => s.left (X i) - s.right (X i)) := by
  let J : Ideal T :=
    Ideal.span (Set.range fun i : Fin 2 => s.left (X i) - s.right (X i))
  have hscalar : collisionPairMap s (C c) = algebraMap ℂ T c := by
    simp [collisionPairMap]
  have hmod : collisionPairMap s (ExplicitSecant.determinant F) -
      algebraMap ℂ T c ∈ J := by
    simpa only [map_sub, hscalar] using
      collisionPairMap_diagonalIdeal_mem_span_coordinateDifferences
        F s (ExplicitSecant.determinant F - C c)
        (ExplicitSecant.determinant_sub_constant_mem_diagonalIdeal F c hJacobian)
  have hmul := J.mul_mem_left (algebraMap ℂ T c⁻¹) hmod
  have hconst : algebraMap ℂ T c⁻¹ * algebraMap ℂ T c = 1 := by
    rw [← map_mul, inv_mul_cancel₀ hc, map_one]
  rw [collisionLift_explicitProjector_formula]
  have heq :
      1 - algebraMap ℂ T c⁻¹ * collisionPairMap s (ExplicitSecant.determinant F) =
        -(algebraMap ℂ T c⁻¹ *
          (collisionPairMap s (ExplicitSecant.determinant F) - algebraMap ℂ T c)) := by
    calc
      _ = algebraMap ℂ T c⁻¹ * algebraMap ℂ T c -
          algebraMap ℂ T c⁻¹ * collisionPairMap s (ExplicitSecant.determinant F) := by
        rw [hconst]
      _ = _ := by ring
  rw [heq]
  exact J.neg_mem hmul

/-- A distinct Keller collision pair has no common coordinate-residue
center: its two coordinate differences generate the unit ideal in `T`.
This is a statement in the actual target algebra, not its fraction field. -/
theorem span_coordinateDifferences_eq_top_of_left_ne_right
    [IsDomain T] (F : PlanarPolynomialMap) (c : ℂ) (hc : c ≠ 0)
    (hJacobian : planarJacobianDet F = C c)
    (s : CollisionMapPair F T) (hne : s.left ≠ s.right) :
    Ideal.span (Set.range fun i : Fin 2 => s.left (X i) - s.right (X i)) = ⊤ := by
  have hmem := collisionLift_explicitProjector_mem_span_coordinateDifferences
    F c hc hJacobian s
  rw [collisionLift_explicitProjector_eq_one_of_left_ne_right F c hc s hne] at hmem
  exact (Ideal.eq_top_iff_one _).mpr hmem

end

end CollisionIdeals.Planar.Research

import CollisionIdeals.General.Keller.DivisorVisibility

/-!
# Divisibility reflected by the polynomial Keller source

Every prime target factor has a visible source divisor. Consequently,
divisibility between elements of the coordinate-image algebra can be
checked in the polynomial source ring. Factorization upgrades this from
prime factors to arbitrary elements, including zero and units. Clearing
one fraction then proves `A ∩ K = B` inside the source function field.

This controls the original polynomial source only. It does not assert
the same reflection for the algebra generated by all conjugate sources.
-/

set_option autoImplicit false

namespace CollisionIdeals

noncomputable section

universe u

variable {k : Type u} [Field k] {n : ℕ}

/-- A prime element of the coordinate-image algebra divides another base
element whenever it divides that element in the polynomial Keller source. -/
theorem polynomialSource_prime_dvd_iff_of_isKeller
    (F : PolynomialSelfMap k n) (hKeller : IsKeller F)
    (b a : PolynomialImageAlgebra F) (hb : Prime b) :
    (algebraMap (PolynomialImageAlgebra F) (SourceRing k (Fin n)) b ∣
      algebraMap (PolynomialImageAlgebra F) (SourceRing k (Fin n)) a) ↔ b ∣ a := by
  constructor
  · intro hba
    obtain ⟨q, _, hcontract, _⟩ :=
      exists_visible_source_divisor_of_isKeller F hKeller b hb
    have hbmem : (b : SourceRing k (Fin n)) ∈ q.asIdeal := by
      change b ∈ q.asIdeal.under (PolynomialImageAlgebra F)
      rw [hcontract]
      exact Ideal.subset_span (Set.mem_singleton b)
    have hamem : a ∈ q.asIdeal.under (PolynomialImageAlgebra F) :=
      q.asIdeal.mem_of_dvd hba hbmem
    rw [hcontract] at hamem
    exact Ideal.mem_span_singleton.mp hamem
  · exact map_dvd (algebraMap (PolynomialImageAlgebra F) (SourceRing k (Fin n)))

/-- The inclusion of a Keller coordinate-image algebra into the polynomial
source reflects divisibility. This is not a claim about conjugate overrings. -/
theorem polynomialSource_dvd_iff_of_isKeller
    (F : PolynomialSelfMap k n) (hKeller : IsKeller F)
    (b a : PolynomialImageAlgebra F) :
    (algebraMap (PolynomialImageAlgebra F) (SourceRing k (Fin n)) b ∣
      algebraMap (PolynomialImageAlgebra F) (SourceRing k (Fin n)) a) ↔ b ∣ a := by
  constructor
  · let B := PolynomialImageAlgebra F
    let A := SourceRing k (Fin n)
    let e := (AlgEquiv.ofInjective (coordinateAlgHom F)
      (coordinateAlgHom_injective_of_isKeller F hKeller)).toMulEquiv
    letI : UniqueFactorizationMonoid B :=
      MulEquiv.uniqueFactorizationMonoid e inferInstance
    have hreflect : ∀ b : B, ∀ a : B, (b : A) ∣ (a : A) → b ∣ a := by
      intro b
      induction b using UniqueFactorizationMonoid.induction_on_prime with
      | h₁ =>
          intro a ha
          have ha0 : a = 0 := Subtype.ext (zero_dvd_iff.mp ha)
          simp [ha0]
      | h₂ b hb =>
          intro a _
          exact hb.dvd
      | h₃ b p _ hp ih =>
          intro a hpa
          have hpdiv : (p : A) ∣ (a : A) :=
            (dvd_mul_right (p : A) (b : A)).trans hpa
          obtain ⟨c, rfl⟩ :=
            (polynomialSource_prime_dvd_iff_of_isKeller F hKeller p a hp).mp hpdiv
          have hp0 : (p : A) ≠ 0 := fun h => hp.ne_zero (Subtype.ext h)
          have hbc : (b : A) ∣ (c : A) :=
            (mul_dvd_mul_iff_left hp0).mp hpa
          exact mul_dvd_mul_left p (ih c hbc)
    exact hreflect b a
  · exact map_dvd (algebraMap (PolynomialImageAlgebra F) (SourceRing k (Fin n)))

/-- Inside the source function field, the polynomial Keller source meets
the base function field exactly in the coordinate-image algebra: `A ∩ K = B`.
This does not identify an invariant conjugate overring with `B`. -/
theorem polynomialSource_mem_range_baseField_iff_of_isKeller
    (F : PolynomialSelfMap k n) (hKeller : IsKeller F)
    (a : SourceRing k (Fin n)) :
    algebraMap (SourceRing k (Fin n)) (PolynomialMapSourceFunctionField F) a ∈
      Set.range (algebraMap (PolynomialMapBaseFunctionField F)
        (PolynomialMapSourceFunctionField F)) ↔ a ∈ PolynomialImageAlgebra F := by
  let B := PolynomialImageAlgebra F
  let A := SourceRing k (Fin n)
  let K := PolynomialMapBaseFunctionField F
  let L := PolynomialMapSourceFunctionField F
  have hmap (r : B) :
      algebraMap K L (algebraMap B K r) = algebraMap A L (r : A) := by
    rw [← IsScalarTower.algebraMap_apply B K L,
      IsScalarTower.algebraMap_apply B A L]
    rfl
  constructor
  · rintro ⟨z, hz⟩
    obtain ⟨r, s, hs, hfrac⟩ := IsFractionRing.div_surjective (A := B) z
    have hsA : (s : A) ≠ 0 := fun h =>
      (mem_nonZeroDivisors_iff_ne_zero.mp hs) (Subtype.ext h)
    have hsL : algebraMap A L (s : A) ≠ 0 := by
      simpa only [map_zero] using (IsFractionRing.injective A L).ne hsA
    have hfracL : algebraMap A L (r : A) / algebraMap A L (s : A) =
        algebraMap A L a := by
      have heq := congrArg (algebraMap K L) hfrac
      change algebraMap K L (algebraMap B K r / algebraMap B K s) =
        algebraMap K L z at heq
      change algebraMap K L z = algebraMap A L a at hz
      rwa [map_div₀, hmap, hmap, hz] at heq
    have hcross : (s : A) * a = (r : A) := by
      apply IsFractionRing.injective A L
      rw [map_mul, mul_comm]
      exact ((div_eq_iff hsL).mp hfracL).symm
    have hdiv : s ∣ r :=
      (polynomialSource_dvd_iff_of_isKeller F hKeller s r).mp ⟨a, hcross.symm⟩
    obtain ⟨c, hc⟩ := hdiv
    have ha : a = (c : A) := by
      apply mul_left_cancel₀ hsA
      exact hcross.trans (congrArg (fun z : B => (z : A)) hc)
    exact ha ▸ c.property
  · intro ha
    refine ⟨algebraMap B K ⟨a, ha⟩, ?_⟩
    exact hmap ⟨a, ha⟩

end

end CollisionIdeals

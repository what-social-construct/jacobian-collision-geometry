import CollisionIdeals.General.ResidualCollision.GenericBaseChange

/-!
# The affine residual quotient on the generic fiber

When the affine diagonal is clopen, the two projection kernels are
generated by complementary idempotents. Base change preserves these
generators and their complementary relation, so the affine first-colon
quotient becomes the intrinsic generic residual quotient. In a marked
product decomposition it is therefore the second factor.
-/

set_option autoImplicit false
set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 100000

namespace CollisionIdeals

noncomputable section

open scoped TensorProduct

universe u v w

variable {R : Type u} [CommRing R] [IsDomain R]
variable {ι κ : Type v}

omit [IsDomain R] in
/-- The affine residual projection kills the complementary idempotent summand. -/
theorem collisionToOffDiagonal_ker_eq_span_complement
    (F : κ → SourceRing R ι) (q : CollisionRing F)
    (hq : IsCollisionOffDiagonalProjector F q) :
    RingHom.ker (collisionToOffDiagonal F).toRingHom = Ideal.span {1 - q} := by
  apply Ideal.comap_injective_of_surjective (Ideal.Quotient.mk (collisionIdeal F))
    Ideal.Quotient.mk_surjective
  rw [RingHom.comap_ker]
  change RingHom.ker (Ideal.Quotient.mk (collisionOffDiagonalIdeal F)) = _
  rw [Ideal.mk_ker]
  exact offDiagonalColonIdeal_eq_comap_complement _ _ q
    (isClopenModulo_of_collisionOffDiagonalProjector F q hq)

/-- Following base change, the residual quotient has kernel the
annihilator of the marked diagonal kernel. -/
theorem polynomialGenericCollisionToOffDiagonal_ker_eq_annihilator
    (F : κ → SourceRing R ι) (q : CollisionRing F)
    (hq : IsCollisionOffDiagonalProjector F q) :
    let B := polynomialMapImageAlgebra F
    let K := PolynomialBaseFunctionField F
    letI : Algebra B (CollisionRing F) := polynomialImageCollisionAlgebra F
    letI : Algebra B (OffDiagonalRing F) := polynomialImageOffDiagonalAlgebra F
    RingHom.ker (polynomialGenericCollisionToOffDiagonal F).toRingHom =
      (RingHom.ker (Algebra.TensorProduct.map (AlgHom.id K K)
        (polynomialImageCollisionDiagonal F)).toRingHom).annihilator := by
  let B := polynomialMapImageAlgebra F
  let K := PolynomialBaseFunctionField F
  let C := CollisionRing F
  letI : Algebra B C := polynomialImageCollisionAlgebra F
  letI : Algebra B (OffDiagonalRing F) := polynomialImageOffDiagonalAlgebra F
  let j : C →ₐ[B] K ⊗[B] C := Algebra.TensorProduct.includeRight
  change RingHom.ker (Algebra.TensorProduct.map (AlgHom.id B K)
      (polynomialImageCollisionToOffDiagonal F)) =
    (RingHom.ker (Algebra.TensorProduct.map (AlgHom.id B K)
      (polynomialImageCollisionDiagonal F))).annihilator
  have hsurjO : Function.Surjective (polynomialImageCollisionToOffDiagonal F) :=
    Ideal.Quotient.factor_surjective (collisionIdeal_le_collisionOffDiagonalIdeal F)
  have hsurjD : Function.Surjective (polynomialImageCollisionDiagonal F) :=
    collisionDiagonal_surjective F
  rw [Algebra.TensorProduct.lTensor_ker (A := K) _ hsurjO,
    Algebra.TensorProduct.lTensor_ker (A := K) _ hsurjD]
  change (RingHom.ker (collisionToOffDiagonal F).toRingHom).map j =
    ((RingHom.ker (collisionDiagonal F).toRingHom).map j).annihilator
  rw [collisionToOffDiagonal_ker_eq_span_complement F q hq,
    collisionDiagonal_ker F, hq.2, Ideal.map_span, Ideal.map_span,
    Set.image_singleton, Set.image_singleton, map_sub, map_one]
  exact (annihilator_span_idempotent (A := K ⊗[B] C) (q := j q) (hq.1.map j)).symm

/-- The actual base-changed affine residual is the second factor of
any generic collision product marked by the diagonal. -/
def polynomialGenericOffDiagonalEquivOfProduct
    (F : κ → SourceRing R ι) (q : CollisionRing F)
    (hq : IsCollisionOffDiagonalProjector F q)
    (hsurj : Function.Surjective (polynomialGenericSourceTensorMap F))
    {N : Type w} [CommRing N] [Algebra (PolynomialBaseFunctionField F) N]
    (e : let B := polynomialMapImageAlgebra F
      let K := PolynomialBaseFunctionField F
      letI : Algebra B (CollisionRing F) := polynomialImageCollisionAlgebra F
      K ⊗[B] CollisionRing F ≃ₐ[K]
        PolynomialSourceFunctionField (R := R) (ι := ι) × N)
    (hdiag : let B := polynomialMapImageAlgebra F
      let K := PolynomialBaseFunctionField F
      let L := PolynomialSourceFunctionField (R := R) (ι := ι)
      letI : Algebra B (CollisionRing F) := polynomialImageCollisionAlgebra F
      (AlgHom.fst K L N).comp e.toAlgHom = polynomialGenericCollisionDiagonal F hsurj) :
    let B := polynomialMapImageAlgebra F
    let K := PolynomialBaseFunctionField F
    letI : Algebra B (OffDiagonalRing F) := polynomialImageOffDiagonalAlgebra F
    K ⊗[B] OffDiagonalRing F ≃ₐ[K] N := by
  let B := polynomialMapImageAlgebra F
  let K := PolynomialBaseFunctionField F
  let L := PolynomialSourceFunctionField (R := R) (ι := ι)
  letI : Algebra B (CollisionRing F) := polynomialImageCollisionAlgebra F
  letI : Algebra B (OffDiagonalRing F) := polynomialImageOffDiagonalAlgebra F
  let f := polynomialGenericCollisionToOffDiagonal F
  let g := (AlgHom.snd K L N).comp e.toAlgHom
  have hdiag' : (AlgHom.fst K L N).comp e.toAlgHom =
      polynomialGenericCollisionDiagonal F hsurj := hdiag
  have hkerD : RingHom.ker (polynomialGenericCollisionDiagonal F hsurj).toRingHom =
      RingHom.ker (Algebra.TensorProduct.map (AlgHom.id K K)
        (polynomialImageCollisionDiagonal F)).toRingHom := by
    change RingHom.ker ((polynomialGenericSourceEquiv F hsurj).toAlgHom.toRingHom.comp
      (Algebra.TensorProduct.map (AlgHom.id K K)
        (polynomialImageCollisionDiagonal F)).toRingHom) = _
    exact RingHom.ker_comp_of_injective _ (polynomialGenericSourceEquiv F hsurj).injective
  have hprod := annihilator_diagonalKernel_eq_residualKernel
    (K := K) (C := K ⊗[B] CollisionRing F) (D := L) (N := N) e
  have hfg : RingHom.ker f = RingHom.ker g := by
    change RingHom.ker (polynomialGenericCollisionToOffDiagonal F).toRingHom =
      RingHom.ker ((AlgHom.snd K L N).comp e.toAlgHom)
    rw [polynomialGenericCollisionToOffDiagonal_ker_eq_annihilator F q hq, ← hkerD]
    change (RingHom.ker (polynomialGenericCollisionDiagonal F hsurj)).annihilator = _
    rw [← hdiag']
    exact hprod
  have hg : Function.Surjective g := by
    intro n
    refine ⟨e.symm (0, n), ?_⟩
    change (e (e.symm (0, n))).2 = n
    rw [AlgEquiv.apply_symm_apply]
  exact (Ideal.quotientKerAlgEquivOfSurjective
      (polynomialGenericCollisionToOffDiagonal_surjective F)).symm |>.trans
    ((Ideal.quotientEquivAlgOfEq K hfg).trans (Ideal.quotientKerAlgEquivOfSurjective hg))

/-- The comparison is compatible with taking the residual projection. -/
theorem polynomialGenericOffDiagonalEquivOfProduct_apply
    (F : κ → SourceRing R ι) (q : CollisionRing F)
    (hq : IsCollisionOffDiagonalProjector F q)
    (hsurj : Function.Surjective (polynomialGenericSourceTensorMap F))
    {N : Type w} [CommRing N] [Algebra (PolynomialBaseFunctionField F) N]
    (e : let B := polynomialMapImageAlgebra F
      let K := PolynomialBaseFunctionField F
      letI : Algebra B (CollisionRing F) := polynomialImageCollisionAlgebra F
      K ⊗[B] CollisionRing F ≃ₐ[K]
        PolynomialSourceFunctionField (R := R) (ι := ι) × N)
    (hdiag : let B := polynomialMapImageAlgebra F
      let K := PolynomialBaseFunctionField F
      let L := PolynomialSourceFunctionField (R := R) (ι := ι)
      letI : Algebra B (CollisionRing F) := polynomialImageCollisionAlgebra F
      (AlgHom.fst K L N).comp e.toAlgHom = polynomialGenericCollisionDiagonal F hsurj) :
    let B := polynomialMapImageAlgebra F
    let K := PolynomialBaseFunctionField F
    letI : Algebra B (CollisionRing F) := polynomialImageCollisionAlgebra F
    letI : Algebra B (OffDiagonalRing F) := polynomialImageOffDiagonalAlgebra F
    ∀ x : K ⊗[B] CollisionRing F,
      polynomialGenericOffDiagonalEquivOfProduct F q hq hsurj e hdiag
        (polynomialGenericCollisionToOffDiagonal F x) = (e x).2 := by
  dsimp only
  intro x
  simp only [polynomialGenericOffDiagonalEquivOfProduct, AlgEquiv.trans_apply,
    Ideal.quotientKerAlgEquivOfSurjective_symm_apply, Ideal.quotientEquivAlgOfEq_mk,
    Ideal.quotientKerAlgEquivOfSurjective_mk, AlgHom.comp_apply, AlgHom.snd_apply] <;> rfl

end

end CollisionIdeals
